# Clerk authentication — https://dashboard.clerk.com → API keys.
# Next.js loads this file automatically (.env / .env.local); copy it to
# `.env` and fill in real keys. Never commit real keys (.env is gitignored).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Recommended external Fernet key for Garmin credentials. Inject this secret to
# keep key material outside the data volume. If omitted, the pre-cutover app
# generates `/data/secret.key` (0600), which must persist across deploys.
# GARMIN_COACH_SECRET_KEY=replace_with_a_fernet_key

# Optional: store root the dashboard reads (the directory that contains
# `derived/`). Defaults to ../data for local dev; the container sets /data.
# GARMIN_COACH_DATA_DIR=../data

