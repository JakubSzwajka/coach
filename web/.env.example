# Clerk authentication — https://dashboard.clerk.com → API keys.
# Copy to web/.env for local development. Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Server-only private adapter settings for `pnpm dev` outside Compose. Neither
# name starts with NEXT_PUBLIC, and coach-client.ts cannot be imported by a
# Client Component. Compose injects both values from the root environment.
GARMIN_COACH_HTTP_URL=http://127.0.0.1:8080
GARMIN_COACH_HTTP_SERVICE_TOKEN=replace-with-generated-service-token
