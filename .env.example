# Copy this file to .env and replace every placeholder you use.
# .env is gitignored and loaded automatically by the collector and remote MCP server.
# Never commit real credentials, tokens, user IDs, or client IDs.

# Garmin Connect credentials used by the collector. Tokens are cached in
# ~/.garminconnect after first login, so these are only used for re-authentication.

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Optional: override where auth tokens are cached (default: ~/.garminconnect)
# GARMINTOKENS=~/.garminconnect

# Clerk-protected remote MCP.
GARMIN_COACH_DATA_DIR=data
GARMIN_COACH_MCP_PUBLIC_URL=http://127.0.0.1:8765/mcp
GARMIN_COACH_CLERK_ISSUER=https://example.clerk.accounts.dev
# Each verified Clerk subject is scoped to its own Profile. Restrict who can
# join/sign in through the Clerk application configuration.
GARMIN_COACH_CLERK_SECRET_KEY=sk_test_example

# PostgreSQL M1 runtime. Generate distinct deployment-local passwords; never
# commit them. Migrations own the schema; the application role is non-superuser.
GARMIN_COACH_POSTGRES_DB=coach
GARMIN_COACH_POSTGRES_ADMIN_USER=coach_admin
GARMIN_COACH_POSTGRES_ADMIN_PASSWORD=replace-with-generated-admin-password
GARMIN_COACH_POSTGRES_APP_USER=coach
GARMIN_COACH_POSTGRES_APP_PASSWORD=replace-with-generated-app-password
GARMIN_COACH_POSTGRES_PORT=5432
GARMIN_COACH_MIGRATION_DATABASE_URL=postgresql://coach_admin:replace-with-generated-admin-password@127.0.0.1:5432/coach
GARMIN_COACH_DATABASE_URL=postgresql://coach:replace-with-generated-app-password@127.0.0.1:5432/coach
