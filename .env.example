# Copy to .env and replace every placeholder you use. Never commit .env.
# Values below are examples only: no real credentials, tokens, subjects, or ids.

# One-stack PostgreSQL roles. Use distinct generated passwords. The Compose URLs
# use service hostname `postgres`; local host commands may override with
# `127.0.0.1` in the invoking shell.
GARMIN_COACH_POSTGRES_DB=coach
GARMIN_COACH_POSTGRES_ADMIN_USER=coach_admin
GARMIN_COACH_POSTGRES_ADMIN_PASSWORD=replace-with-generated-admin-password
GARMIN_COACH_POSTGRES_APP_USER=coach
GARMIN_COACH_POSTGRES_APP_PASSWORD=replace-with-generated-app-password
GARMIN_COACH_POSTGRES_PORT=5432
GARMIN_COACH_MIGRATION_DATABASE_URL=postgresql://coach_admin:replace-with-generated-admin-password@postgres:5432/coach
GARMIN_COACH_DATABASE_URL=postgresql://coach:replace-with-generated-app-password@postgres:5432/coach

# Private Python adapter. Generate the service token and Fernet key; neither is
# public browser configuration. The Clerk issuer is a non-secret origin.
GARMIN_COACH_CLERK_ISSUER=https://example.clerk.accounts.dev
GARMIN_COACH_HTTP_SERVICE_TOKEN=replace-with-generated-service-token
GARMIN_COACH_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Clerk-protected read-only remote MCP (optional).
GARMIN_COACH_MCP_PUBLIC_URL=http://127.0.0.1:8765/mcp
GARMIN_COACH_CLERK_SECRET_KEY=sk_test_example

# Local MCP/collector actor (optional). These are deployment-local placeholders,
# not a browser parameter and not a Profile id.
GARMIN_COACH_LOCAL_ACTOR_ISSUER=https://local.example.test
GARMIN_COACH_LOCAL_ACTOR_SUBJECT=local-owner-placeholder

# Optional direct collector reconnect. The web Connect route normally supplies
# these to the private adapter instead; Garmin remains read-only.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=replace-with-garmin-password
