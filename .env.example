# Garmin Connect credentials used by the collector.
# Copy to .env and fill in, then load into your shell before running:
#   set -a; source .env; set +a
# (.env is gitignored. Tokens are cached in ~/.garminconnect after first login,
#  so credentials are only used on the rare re-auth.)

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Optional: override where auth tokens are cached (default: ~/.garminconnect)
# GARMINTOKENS=~/.garminconnect
