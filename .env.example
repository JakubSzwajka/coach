# Copy this file to .env and replace every placeholder you use.
# .env is gitignored and loaded automatically by the collector and remote MCP server.
# Never commit real credentials, tokens, user IDs, or client IDs.

# Garmin Connect credentials used by the collector. Tokens are cached in
# ~/.garminconnect after first login, so these are only used for re-authentication.

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Optional: override where auth tokens are cached (default: ~/.garminconnect)
# GARMINTOKENS=~/.garminconnect

# Clerk-protected remote MCP.
GARMIN_COACH_DATA_DIR=data
GARMIN_COACH_MCP_PUBLIC_URL=http://127.0.0.1:8765/mcp
GARMIN_COACH_CLERK_ISSUER=https://example.clerk.accounts.dev
# Comma-separated Clerk User IDs allowed to read this one shared athlete profile.
GARMIN_COACH_CLERK_ALLOWED_SUBJECTS=user_example
GARMIN_COACH_CLERK_SECRET_KEY=sk_test_example
